<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>VirtioTablet</string>
	<key>CFBundleIdentifier</key>
	<string>io.virtio.driver.VirtioTablet</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VirtioTablet</string>
	<key>CFBundlePackageType</key>
	<string>KEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>IOKitPersonalities</key>
	<dict>
		<!-- QEMU's virtio input devices: virtio-tablet-pci, virtio-mouse-pci and virtio-keyboard-pci
		     are all 1af4:1052 (modern only); the driver takes the two pointers and declines the
		     keyboard. By vendor and device where IOPCIFamily matches IOPCIMatch, and by the name
		     OpenBIOS gives the node where it matches names. Polled set to true makes the driver
		     poll even where the device's interrupt could be had. -->
		<key>VirtioTablet</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>io.virtio.driver.VirtioTablet</string>
			<key>IOClass</key>
			<string>io_virtio_VirtioTablet</string>
			<key>IOPCIMatch</key>
			<string>0x10521af4</string>
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<key>Polled</key>
			<false/>
		</dict>
		<key>VirtioTabletByName</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>io.virtio.driver.VirtioTablet</string>
			<key>IOClass</key>
			<string>io_virtio_VirtioTablet</string>
			<key>IONameMatch</key>
			<string>pci1af4,1052</string>
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<key>Polled</key>
			<false/>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
@LIBRARIES@
	</dict>
</dict>
</plist>
